# INACTIVE DRAFT: never install without exact, separate user activation approval.
# Stage A intentionally fails activation validation until its reviewed source commit exists.
name: HQ OIDC bootstrap PR11 v1
on:
  pull_request:
    types: [synchronize]
    branches: [main]
permissions: {}
jobs:
  proof:
    if: >-
      github.event_name == 'pull_request' && github.event.action == 'synchronize' &&
      github.event.number == 11 && github.event.pull_request.number == 11 &&
      github.repository == 'haji84/PERSONAL-AI-HQ' &&
      github.repository_id == '1437383396' && github.repository_owner_id == '173585154' &&
      github.event.repository.private == false &&
      github.event.pull_request.head.repo.full_name == 'haji84/PERSONAL-AI-HQ' &&
      github.event.pull_request.head.repo.id == 1437383396 &&
      github.event.pull_request.head.repo.owner.id == 173585154 &&
      github.event.pull_request.head.repo.private == false &&
      github.event.pull_request.base.repo.full_name == 'haji84/PERSONAL-AI-HQ' &&
      github.event.pull_request.base.repo.id == 1437383396 &&
      github.event.pull_request.base.repo.owner.id == 173585154 &&
      github.event.pull_request.base.repo.private == false &&
      github.head_ref == 'feature/autonomous-manager-bootstrap' &&
      github.base_ref == 'main' && github.ref == 'refs/pull/11/merge' &&
      github.run_number == '1' && github.run_attempt == '1'
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      contents: read
      id-token: write
    steps:
      - name: Check out only the reviewed verifier source
        id: source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: haji84/PERSONAL-AI-HQ
          ref: REQUIRES_REVIEWED_SOURCE_COMMIT
          persist-credentials: false
          fetch-depth: 1
          submodules: false
          lfs: false
      - name: Set exact Node runtime without package caching
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: '22.23.4'
          package-manager-cache: false
          check-latest: false
      - name: Install only reviewed production dependencies without scripts
        run: |
          if ! npm ci --omit=dev --ignore-scripts --no-audit --no-fund > /dev/null 2>&1; then
            printf '%s\n' 'OIDC_BOOTSTRAP_FAILED' >&2
            exit 1
          fi
      - name: Verify once and emit only public identity fields
        env:
          HQ_BOOTSTRAP_SOURCE_SHA: REQUIRES_REVIEWED_SOURCE_COMMIT
          HQ_BOOTSTRAP_CHECKOUT_SHA: ${{ steps.source.outputs.commit }}
          HQ_BOOTSTRAP_CHECK_RUN_ID: ${{ job.check_run_id }}
          NODE_OPTIONS: ''
        run: node scripts/oidc-bootstrap-proof.mjs --github-oidc-bootstrap-once
